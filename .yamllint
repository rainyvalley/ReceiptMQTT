# yamllint config for the workflows. The `on:` key (a YAML 1.1 boolean)
# is intrinsic to GitHub Actions; line-length is relaxed for readability
# of long action refs and run blocks.
extends: default

rules:
  truthy:
    check-keys: false
  line-length:
    max: 120
  document-start:
    ignore: |
      .github/workflows/*.yml
  comments-indentation: false